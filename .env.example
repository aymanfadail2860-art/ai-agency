# ---------------------------------------------------------------------------
# AI Agency Platform — miljøvariabler (V3)
# Kopiér til apps/web/.env.local (eller sæt dem i miljøet). Commit ALDRIG rigtige nøgler.
# Platformen kører fuldt i Demo Mode uden nogen af disse.
# ---------------------------------------------------------------------------

# Standardtilstand ved første opstart: demo | live (kan skiftes under Indstillinger)
PLATFORM_DEFAULT_MODE=demo

# Hvor den lokale JSON-lagring skrives (standard: <repo>/.data)
# DATA_DIR=/absolut/sti/til/data

# --- Supabase: datalager + adgangskontrol (V4.1) ----------------------------
SUPABASE_URL=
# Servernøgle (kun server-side, "Sensitive" i Vercel) — eneste adgang til datalageret
# (public.documents er låst til servernøglen). Uden den bruges lokale JSON-filer.
SUPABASE_SECRET_KEY=
# Offentlig nøgle (sb_publishable_…) — bruges KUN til Supabase Auth (login). Ikke hemmelig.
# Uden den er platformen lukket: sider viser "Adgangskontrol er ikke konfigureret", API'er svarer 503.
# Lokalt: node scripts/local-auth/start.mjs (rigtig Supabase Auth i Docker) — se docs/auth-setup.md.
SUPABASE_PUBLISHABLE_KEY=
# Login-begrænsning pr. IP pr. 15 min (standard 10). Hæves kun til test.
# LOGIN_RATE_LIMIT_PER_IP=10

# Bureauets navn på tilbud og PDF
AGENCY_NAME="AI Agency"

# --- CVR-opslag (Live Mode) -------------------------------------------------
# cvrdev = https://cvr.dev (API-nøgle) · virk = Erhvervsstyrelsens system-til-system-adgang
CVR_PROVIDER=cvrdev
CVR_DEV_API_KEY=
# CVR_DEV_BASE_URL=https://api.cvr.dev
CVR_VIRK_USERNAME=
CVR_VIRK_PASSWORD=
# CVR_VIRK_BASE_URL=http://distribution.virk.dk

# --- AI (Anthropic Claude) ---------------------------------------------------
# Uden nøgle bruges gennemsigtig regelbaseret analyse og tilbudsskabelon (tydeligt markeret).
ANTHROPIC_API_KEY=
# Modellen verificeres via Anthropics Models API under Indstillinger.
ANTHROPIC_MODEL=claude-opus-5-5
# Maks. tegn sendt til AI pr. analyse (standard 60000)
# AI_MAX_INPUT_CHARS=60000
# Prisestimat (USD pr. mio. tokens) for modeller uden kendt pris
# AI_PRICE_INPUT_PER_MTOK=
# AI_PRICE_OUTPUT_PER_MTOK=

# --- Websøgning (nyheder, job, anmeldelser, konkurrenter) -------------------
BRAVE_SEARCH_API_KEY=

# --- Webhentning --------------------------------------------------------------
# Sæt til false for at slå hentning af hjemmesider fra
RESEARCH_WEBSITE_FETCH=true
# RESEARCH_USER_AGENT="AIAgencyResearchBot/0.1 (+https://ditdomæne.dk/bot)"

# --- Omkostningsgrænser (V2) ----------------------------------------------------
# AI_DAILY_BUDGET_USD=5        # estimeret Claude-forbrug pr. døgn
# SEARCH_DAILY_LIMIT=300       # websøgninger pr. døgn
# RESEARCH_DAILY_LIMIT=40      # researchjob pr. døgn (Live Mode)
# CVR_DAILY_LIMIT=500          # CVR-opslag pr. døgn (inkl. P-numre)
# RESEARCH_MAX_PAGES=8         # maks. sider pr. hjemmeside-crawl
# CLAUDE_CODE_DAILY_LIMIT=20   # Claude Code-rutinekørsler pr. døgn (abonnement)
# AI_APPROVAL_THRESHOLD_USD=1  # API-job med højere estimat kræver godkendelse i AOS

# --- Claude Code-rutiner (V3, motor A) ----------------------------------------
# Opsætning: routines/ai-agency-job.md. Token vises kun én gang i claude.ai/code/routines.
# Sæt som "Sensitive" i Vercel — aldrig i repositoriet.
CLAUDE_CODE_ROUTINE_RESEARCH_ID=
CLAUDE_CODE_ROUTINE_RESEARCH_TOKEN=
# Offentlig adresse, som sessionen melder resultatet tilbage til (https)
AGENCY_PUBLIC_URL=
# CLAUDE_CODE_JOB_TIMEOUT_MINUTES=90   # herefter vises jobbet som forsinket
# CLAUDE_CODE_CALLBACK_HOURS=24        # engangsnøglens levetid
